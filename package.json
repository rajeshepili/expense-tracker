{
  "name": "expense-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "VITE_SITE_MODE=app vite dev --port 3000",
    "dev:app": "VITE_SITE_MODE=app vite dev",
    "dev:mkt": "VITE_SITE_MODE=marketing vite dev",
    "dev:portless": "portless run --name app.pocketbook pnpm dev:app",
    "dev:portless:mkt": "portless run --name pocketbook pnpm dev:mkt",
    "generate-routes": "node scripts/generate-routes.mjs",
    "build": "vite build && node scripts/serwist-inject.mjs",
    "build:app": "VITE_SITE_MODE=app vite build && node scripts/serwist-inject.mjs",
    "build:mkt": "VITE_SITE_MODE=marketing vite build",
    "serwist:inject": "node scripts/serwist-inject.mjs",
    "assert:app-sw": "node scripts/assert-app-sw.mjs",
    "assert:mkt-bundle": "node scripts/assert-marketing-bundle.mjs",
    "preview": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "3.51.2-build9",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-virtual": "^3.14.24",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "motion": "^14.9.0",
    "nitro": "3.0.260610-beta",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serwist": "^9.5.13",
    "sonner": "^2.0.8",
    "sqlocal": "^0.18.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@serwist/build": "^9.5.13",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/intent": "^0.5.6",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
