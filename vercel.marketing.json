{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": ".output/public",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "tanstack-start",
  "redirects": [
    {
      "source": "/ledger",
      "destination": "https://expense-tracker-amber-two-58.vercel.app/ledger",
      "permanent": false
    },
    {
      "source": "/ledger/:path*",
      "destination": "https://expense-tracker-amber-two-58.vercel.app/ledger/:path*",
      "permanent": false
    },
    {
      "source": "/recurring",
      "destination": "https://expense-tracker-amber-two-58.vercel.app/recurring",
      "permanent": false
    },
    {
      "source": "/recurring/:path*",
      "destination": "https://expense-tracker-amber-two-58.vercel.app/recurring/:path*",
      "permanent": false
    },
    {
      "source": "/savings",
      "destination": "https://expense-tracker-amber-two-58.vercel.app/savings",
      "permanent": false
    },
    {
      "source": "/savings/:path*",
      "destination": "https://expense-tracker-amber-two-58.vercel.app/savings/:path*",
      "permanent": false
    },
    {
      "source": "/categories",
      "destination": "https://expense-tracker-amber-two-58.vercel.app/categories",
      "permanent": false
    },
    {
      "source": "/categories/:path*",
      "destination": "https://expense-tracker-amber-two-58.vercel.app/categories/:path*",
      "permanent": false
    },
    {
      "source": "/year",
      "destination": "https://expense-tracker-amber-two-58.vercel.app/year",
      "permanent": false
    },
    {
      "source": "/year/:path*",
      "destination": "https://expense-tracker-amber-two-58.vercel.app/year/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
